{
  "functions": {
    "api/contact.ts": {
      "includeFiles": "lib/**"
    },
    "api/register.ts": {
      "includeFiles": "lib/**"
    },
    "api/prayer.ts": {
      "includeFiles": "lib/**"
    },
    "api/broadcast.ts": {
      "includeFiles": "lib/**"
    },
    "api/program.ts": {
      "includeFiles": "{dist/**,lib/**,firebase-applet-config.json}"
    },
    "api/program-image.ts": {
      "includeFiles": "{lib/**,firebase-applet-config.json}"
    }
  },
  "routes": [
    {
      "src": "/programs/([^/]+)",
      "dest": "/api/program?id=$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
